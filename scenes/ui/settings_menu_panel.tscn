[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_menu_panel.gd" id="1"]

[node name="SettingsMenuPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(380, 0)
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "Settings"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

[node name="Body" type="Label" parent="."]
layout_mode = 2
text = "Volume, mouse sensitivity, reticle color drama, etc. not implemented yet.\n(or hey, do it yourself! It's FOSS after all!)"
horizontal_alignment = 1
autowrap_mode = 3
custom_minimum_size = Vector2(380, 0)

[node name="BackButton" type="Button" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(280, 0)
text = "Back"

[connection signal="pressed" from="BackButton" to="." method="_on_back_pressed"]
