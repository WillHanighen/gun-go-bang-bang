; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gun go bang bang"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"
EggScreenFx="*res://scripts/autoload/egg_screen_fx.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
InputBindingsSave="*res://scripts/autoload/input_bindings_save.gd"
WeaponDatabase="*res://scripts/autoload/weapon_database.gd"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="vulkan"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=true
